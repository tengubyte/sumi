{
  "name": "@tengubyte/sumi",
  "version": "0.1.0",
  "description": "Brush and ink effects for React: paint brush art in the way the stroke was laid, and throw ink splats drawn in code. WebGL, no other dependencies.",
  "license": "MIT",
  "author": "TenguByte (https://tengubyte.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tengubyte/sumi.git"
  },
  "homepage": "https://sumi.tengubyte.io",
  "keywords": [
    "react",
    "webgl",
    "brush",
    "ink",
    "sumi-e",
    "enso",
    "animation",
    "shader"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "prepare": "npm run build",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:site"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
